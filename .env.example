# Copy to .env on the VPS: cp .env.example .env && chmod 600 .env
# Replace every CHANGE_ME value. Never commit the real .env file.

ENVIRONMENT=production
LOG_LEVEL=INFO
MARKETPLACE_DRY_RUN=true
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

POSTGRES_DB=toy_marketplace
POSTGRES_USER=toy_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://toy_app:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/toy_marketplace
REDIS_URL=redis://redis:6379/0

TRENDYOL_SUPPLIER_ID=CHANGE_ME
TRENDYOL_API_KEY=CHANGE_ME
TRENDYOL_API_SECRET=CHANGE_ME
TRENDYOL_BASE_URL=https://apigw.trendyol.com
TRENDYOL_USER_AGENT=ToyMarketplaceIntegration/1.0
TRENDYOL_TIMEOUT_SECONDS=30

HEPSIBURADA_MERCHANT_ID=CHANGE_ME
HEPSIBURADA_USERNAME=CHANGE_ME
HEPSIBURADA_PASSWORD=CHANGE_ME
HEPSIBURADA_BASE_URL=https://listing-external.hepsiburada.com
HEPSIBURADA_TIMEOUT_SECONDS=30

IMAGE_STORAGE=s3
S3_BUCKET=CHANGE_ME
S3_PUBLIC_BASE_URL=https://CHANGE_ME
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Optional public URL / TLS values used by the deployment layer.
PUBLIC_BASE_URL=https://shop.example.com
