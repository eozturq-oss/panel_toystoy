# Copy this file to .env.production on the server and replace every placeholder.
# Never commit the real .env.production file.

ENVIRONMENT=production
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
MARKETPLACE_DRY_RUN=true
CORS_ORIGINS=https://shop.example.com

POSTGRES_DB=toy_marketplace
POSTGRES_USER=toy_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg://toy_app:CHANGE_ME_TO_A_LONG_RANDOM_VALUE@postgres:5432/toy_marketplace
REDIS_URL=redis://redis:6379/0

TRENDYOL_SUPPLIER_ID=CHANGE_ME
TRENDYOL_API_KEY=CHANGE_ME
TRENDYOL_API_SECRET=CHANGE_ME
TRENDYOL_BASE_URL=https://apigw.trendyol.com
TRENDYOL_USER_AGENT=ToyMarketplaceIntegration/1.0
TRENDYOL_TIMEOUT_SECONDS=30

HEPSIBURADA_MERCHANT_ID=CHANGE_ME
HEPSIBURADA_USERNAME=CHANGE_ME
HEPSIBURADA_SECRET_KEY=CHANGE_ME
HEPSIBURADA_BASE_URL=https://listing-external.hepsiburada.com
HEPSIBURADA_TIMEOUT_SECONDS=30

IMAGE_STORAGE=s3
S3_BUCKET=CHANGE_ME
S3_PUBLIC_BASE_URL=https://CHANGE_ME
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

